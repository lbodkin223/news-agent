# ──────────────────────────────────────────────────────────────
#  news-agent configuration
#  Copy to .env and fill in your values:  cp .env.template .env
# ──────────────────────────────────────────────────────────────

# --- Anthropic (required for scoring + summarisation) ---
ANTHROPIC_API_KEY=
# Model override (default: claude-sonnet-4-5-20250929)
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Reddit / PRAW (optional — skipped if blank) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=news-agent/0.1 by YourRedditUsername

# --- Database ---
# NEWS_AGENT_DB=news_agent.db

# --- Output directories ---
# NEWS_AGENT_OUTPUT_DIR=output
# NEWS_AGENT_SUMMARY_DIR=briefings

# --- Email delivery (optional — choose one backend) ---
# Set to "smtp" or "sendgrid" to enable email delivery.
# Leave blank to skip email (file output only).
EMAIL_BACKEND=

# Common
EMAIL_FROM=
EMAIL_TO=recipient@example.com

# SMTP settings (when EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SendGrid settings (when EMAIL_BACKEND=sendgrid)
SENDGRID_API_KEY=

# --- Slack health-check (optional) ---
# Incoming webhook URL for pipeline success/failure alerts.
SLACK_WEBHOOK_URL=
